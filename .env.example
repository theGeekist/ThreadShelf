# Optional external OpenRouter conversation generation.
# Copy this file to .env, paste your key, and restart ThreadShelf.
# Never commit the populated .env file.
OPENROUTER_API_KEY=

# Optional embedding batch limits. The tokenizer/context bound of the active
# model caps sequence length; token budget accounts for batch padding.
EMBED_BATCH_SIZE=25
EMBED_BATCH_TOKEN_BUDGET=2048

# Hugging Face token. The model catalog and normal GGUF downloads work without
# it; it is only required for gated repositories, whose licence you must accept
# on huggingface.co first. HUGGING_FACE_HUB_TOKEN is accepted as an alias.
HF_TOKEN=

# GitHub token. Optional: raises the anonymous API rate limit when ThreadShelf
# resolves the official ggml-org/llama.cpp release. GH_TOKEN is an alias.
GITHUB_TOKEN=

# Optional local Strata server (started separately). Loopback only;
# defaults to http://127.0.0.1:8080 when unset.
STRATA_BASE_URL=
# Only when your Strata server requires a key; sent as a Bearer token.
STRATA_API_KEY=

# Optional external embeddings. Local MiniLM remains the default. When enabled,
# chunk text is sent to Cloudflare Workers AI BGE-M3 and vectors require a
# separate LanceDB index from the local 384-dimensional MiniLM index.
THREADSHELF_EMBEDDING_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBED_BATCH_SIZE=64
# Optional destination for `npm run reindex:cloudflare`.
BGE_M3_LANCEDB_PATH=
